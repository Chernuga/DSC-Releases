<!--
    Launcher foreground: a terminal prompt.

    Drawn as vector paths rather than text so it renders identically at every
    density without depending on a font. The chevron plus underscore is the
    conventional >_ prompt, which reads as "code" at launcher size where a
    more detailed glyph would turn to mush.

    Sized inside the 108dp viewport's safe zone (the inner 72dp) so the shape is
    not clipped by the adaptive-icon mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ">" chevron: two strokes meeting at the right. -->
    <path
        android:pathData="M38,40 L54,54 L38,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- The "_" cursor, sitting on the baseline to the chevron's right. -->
    <path
        android:pathData="M62,68 L76,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
